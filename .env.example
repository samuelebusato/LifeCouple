# Copia questo file in `.env` e valorizza con i dati del progetto Supabase
# (Dashboard -> Project Settings -> API). Il `.env` vero e' nel .gitignore.
#
# ATTENZIONE all'URL: serve la BASE del progetto, senza /rest/v1/ o altri
# suffissi — il client li aggiunge da solo.
#
# Qui va SOLO la chiave "anon"/publishable: e' pubblica per costruzione.
# La chiave service_role NON va mai messa qui, ne' altrove nel repo.

EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<publishable-key>
