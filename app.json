{
  "expo": {
    "name": "LifeCouple",
    "slug": "lifecouple",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lifecouple",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.lifecouple.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.lifecouple.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-localization",
      "@react-native-community/datetimepicker",
      [
        "expo-calendar",
        {
          "calendarPermission": "LifeCouple legge il tuo calendario solo quando scegli di importare qualcosa, e importa unicamente le voci che spunti tu."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LifeCouple usa la posizione per centrare la mappa dove sei e, se sei tu ad accendere la condivisione, per mostrare al tuo partner dove ti trovi adesso. Non ti segue quando l'app è chiusa e non conserva nessuno storico dei tuoi spostamenti.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "LifeCouple accede alle foto solo per quelle che scegli tu di aggiungere ai vostri ricordi."
        }
      ],
      "expo-image",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "322f00d8-59ff-4ae6-9572-255e22124291"
      }
    },
    "owner": "samududjhdnss-team"
  }
}
