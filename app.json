{
  "expo": {
    "name": "LifeCouple",
    "slug": "lifecouple",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lifecouple",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.lifecouple.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.lifecouple.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-localization",
      "@react-native-community/datetimepicker",
      [
        "expo-calendar",
        {
          "calendarPermission": "LifeCouple legge il tuo calendario solo quando scegli di importare qualcosa, e importa unicamente le voci che spunti tu."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "LifeCouple usa la posizione solo quando tocchi «segna dove sono»: non ti segue mai, e il tuo partner non può vedere dove sei adesso."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "LifeCouple accede alle foto solo per quelle che scegli tu di aggiungere ai vostri ricordi."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
